# Copy to .env.local (git-ignored) for laptop runs. In LangSmith, set these on the deployment (secrets as secrets).
# offline = keyword router, demo only
MODEL_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_APIVERSION=2024-10-21
# empty = managed identity
AZURE_OPENAI_API_KEY=
MAX_TOOL_ROUNDS=4
{%- if agent_auth == 'entra' %}
MCP_ROUTE=gateway
GATEWAY_URL=https://<apim>.azure-api.us
AUTH_MODE=azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID={{ identity_client_id }}
ACCEPTED_AUDIENCES={{ identity_uri }},{{ identity_client_id }}
ALLOWED_CALLERS={{ ui_client_id }}
# secrets: LangSmith deployment secrets (from Key Vault), never in code
AZURE_CLIENT_SECRET=
TOKEN_SEALING_KEY=
{%- else %}
MCP_ROUTE=direct
{%- endif %}
{%- for s in uses_mcp.split(',') if s.strip() %}
# direct route only, e.g. https://{{ s.strip() }}.<env>.azurecontainerapps.us/mcp
MCP_URL_{{ s.strip().upper() | replace('-', '_') }}=
{%- endfor %}
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
# true for confidential data classes
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
# Behind the TLS-inspecting proxy on a laptop:
# REQUESTS_CA_BUNDLE=certs/ca-bundle-local.pem
# SSL_CERT_FILE=certs/ca-bundle-local.pem
