"""{{ name }}: {{ purpose }}

Template plumbing (identity, tools per request, step limit) is done for you. Teams change src/agent/prompt.md,
the model settings and, when needed, add nodes. Tools come from the MCP servers listed in agent.yaml."""
from __future__ import annotations

import json
import os
import pathlib

from langchain_core.messages import AIMessage, SystemMessage, ToolMessage
from langchain_core.runnables import RunnableConfig
from langgraph.graph import END, START, MessagesState, StateGraph

from agent.gateway import load_tools
from agent.model import get_model
from platform_auth import InteractionRequired, unseal

SYSTEM = SystemMessage(content=(pathlib.Path(__file__).with_name("prompt.md")).read_text().strip())
MAX_TOOL_ROUNDS = int(os.getenv("MAX_TOOL_ROUNDS", "4"))     # hard stop for runaway tool loops
AGENT_AUTH = "{{ agent_auth }}"                               # off | entra (langgraph.json carries the auth block)


def _user_token(config: RunnableConfig) -> str | None:
    user = (config.get("configurable") or {}).get("langgraph_auth_user")
    try:
        sealed = user["sealed_token"] if user is not None else None
    except (KeyError, TypeError):
        sealed = None
    return unseal(sealed) if sealed else None


async def agent(state: MessagesState, config: RunnableConfig) -> dict:
    token = _user_token(config)
    if AGENT_AUTH == "entra" and not token:
        return {"messages": [AIMessage(content="No signed-in user on this request.")]}
    try:
        tools, down = await load_tools(token)
    except InteractionRequired as e:   # Conditional Access: send the claims back so the UI can re-prompt
        return {"messages": [AIMessage(content="Please sign in again.", additional_kwargs={"claims_challenge": e.claims})]}
    by_name = {t.name: t for t in tools}
    model = get_model()

    new = []
    for _ in range(MAX_TOOL_ROUNDS):
        ai = await model.ainvoke([SYSTEM, *state["messages"], *new], tools)
        new.append(ai)
        if not ai.tool_calls:
            break
        for call in ai.tool_calls:
            tool = by_name.get(call["name"])
            try:
                if tool is None:
                    raise LookupError(f"tool {call['name']} is unavailable right now")
                new.append(await tool.ainvoke({**call, "type": "tool_call"}))   # returns a ToolMessage
            except Exception as e:  # a failing tool becomes an answer, not a crash
                new.append(ToolMessage(content=json.dumps({"error": str(e)[:300]}), tool_call_id=call["id"],
                                       name=call["name"], status="error"))
    else:  # every round asked for more tools: stop, and say so
        new.append(AIMessage(content=f"I stopped after {MAX_TOOL_ROUNDS} tool rounds without a final answer. "
                                     "Please narrow the question."))
    if down:
        new[-1].additional_kwargs["unavailable_tools"] = down
    return {"messages": new}


builder = StateGraph(MessagesState)
builder.add_node("agent", agent)
builder.add_edge(START, "agent")
builder.add_edge("agent", END)
graph = builder.compile()
