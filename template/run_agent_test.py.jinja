"""Smoke test against a running agent (laptop `make run-local` or a LangSmith deployment).
Reads everything from the environment or .env.local - never from code.

PowerShell:
  $env:AGENT_URL = "https://<langsmith-host>/lgp/<deployment-id>/"   # or http://127.0.0.1:2024
  $env:LANGSMITH_API_KEY = "<key>"           # agent_auth=off
  $env:AGENT_BEARER_TOKEN = "<user token>"   # agent_auth=entra (e.g. from scripts/entra_check.py)
  python run_agent_test.py "your question"
"""
import asyncio
import os
import sys

from langgraph_sdk import get_client

try:
    from dotenv import load_dotenv
    load_dotenv(".env.local", override=False)
except ImportError:
    pass

GRAPH = "{{ name | replace('-', '_') }}"


async def main(question: str) -> None:
    url = os.getenv("AGENT_URL") or os.getenv("LANGSMITH_DEPLOYMENT_URL")
    if not url:
        sys.exit("Set AGENT_URL (environment or .env.local)")
    token = os.getenv("AGENT_BEARER_TOKEN")
    client = get_client(url=url, api_key=None if token else os.getenv("LANGSMITH_API_KEY"),
                        headers={"Authorization": f"Bearer {token}"} if token else None)
    thread = await client.threads.create()
    out = await client.runs.wait(thread["thread_id"], GRAPH, input={"messages": [{"role": "user", "content": question}]})
    for m in out["messages"]:
        calls = ", ".join(c["name"] for c in (m.get("tool_calls") or []))
        print(f"[{m['type']}] {str(m.get('content'))[:400]}" + (f"  -> tools: {calls}" if calls else ""))


if __name__ == "__main__":
    asyncio.run(main(" ".join(sys.argv[1:]) or "What can you do?"))
